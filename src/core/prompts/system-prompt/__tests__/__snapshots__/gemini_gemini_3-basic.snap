Invoke edit_file with:
```json
{
  "files": [
    {
      "path": "src/calculator.py",
      "edits":[
        {
          "edit_type": "insert_before",
          "anchor": "Apple§def calculate_total(items):",
          "text": "from typing import List\n"
        },
        {
          "edit_type": "replace",
          "anchor": "Brave§    total = 0",
          "end_anchor": "Eagle§            total += item.price",
          "text": "    total = sum(item.price for item in items if item.price > 0)"
        }
      ]
    },
    {
      "path": "src/user.ts",
      "edits":[
        {
          "edit_type": "replace",
          "anchor": "Karma§  age: number;",
          "end_anchor": "Karma§  age: number;",
          "text": ""
        },
        {
          "edit_type": "replace",
          "anchor": "Ocean§  if (!user.name) {",
          "end_anchor": "River§  return user.name;",
          "text": "  return user.name ? user.name : \"Anonymous\";"
        },
        {
          "edit_type": "insert_after",
          "anchor": "Snake§}",
          "text": "\nexport function isAnonymous(user: User): boolean {\n  return !user.name;\n}"
        }
      ]
    }
  ]
}
```

