Hazel§  id: string;
Index§  name: string;
Joker§  email: string;
Karma§  age: number;
Lemon§}
Mango§
Nacho§export function getUserDisplayName(user: User): string {
Ocean§  if (!user.name) {
Piano§    return "Anonymous";
Quail§  }
River§  return user.name;
Snake§}
